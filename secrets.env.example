# Bot-Factory Secrets Template
# Copy this file to: ~/bot-factory/system/secrets.env
# NEVER commit a populated secrets.env file to Git!

# Mistral Hosted (Mistral Large 4, GLM 5.3, GLM 5.3 Flash)
MISTRAL_API_KEY=

# Google AI / Antigravity (Gemini 4 Hydrogen, Gemini 4 Neon)
GEMINI_API_KEY=

# Optional: Force deterministic offline simulation mode even when keys are set (1 = offline mock)
# BOT_FACTORY_OFFLINE_MOCK=0
