{
  "name": "bot-factory-harness",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:daemon": "bun --watch apps/daemon/src/index.ts",
    "dev:daemon:isolated": "bun apps/daemon/src/cli/devIsolated.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun apps/daemon/src/index.ts",
    "doctor": "bun apps/daemon/src/cli/doctor.ts",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x biome check packages apps tests",
    "test": "bun test tests",
    "scan:security": "bun pm scan",
    "check": "bun run typecheck && bun run lint && bun run build:web && bun test tests"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@types/bun": "1.2.15",
    "typescript": "5.8.3"
  }
}
