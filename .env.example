# Optional runtime overrides for local development.
# Copy this file to .env only if your shell/tooling loads .env automatically.

# Runtime state root. Defaults to ~/bot-factory.
BOT_FACTORY_ROOT=

# Force deterministic offline model behavior (1) or use live providers (empty).
BOT_FACTORY_OFFLINE_MOCK=

# Skip local Python Playwright browser E2E when Chromium is unavailable (1) or run it (empty).
BOT_FACTORY_SKIP_PLAYWRIGHT=

# Optional Socket organization token for enhanced dependency scanning.
# Free mode works without this value.
SOCKET_API_TOKEN=

# Provider API keys belong in ~/bot-factory/system/secrets.env, not here.
# See secrets.env.example.
